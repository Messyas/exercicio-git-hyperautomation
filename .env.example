MAESTRO_ENABLED=false
APP_TIMEZONE=America/Manaus

# Configure estas variáveis somente no ambiente local de desenvolvimento.
# No Runner, o SDK recebe a autenticação pelos argumentos do BotCity.
MAESTRO_SERVER=
MAESTRO_LOGIN=
MAESTRO_KEY=
MAESTRO_TASK_ID=
MAESTRO_ACTIVITY_LABEL=inspecao-lotes

# Caminhos relativos são resolvidos a partir da raiz do projeto.
BOT_INPUT_DIR=dados_entrada
BOT_INPUT_FILE=data/samples/inspecao_lotes_dia.xlsx
BOT_OUTPUT_DIR=data/output
BOT_LOG_DIR=logs
BOT_EXECUTION_REPORT_FILE=logs/resumo_execucao.json

# Handoff entre os dois bots. Use botcity no Runner.
DATAPOOL_BACKEND=local
DATAPOOL_LABEL=Lotes para validação
DATAPOOL_LOCAL_DIR=data/datapool
VALIDATOR_ACTIVITY_LABEL=bot-lotes-validacao-mk7

# IDs injetados em todas as linhas dos logs JSON.
EXECUTION_ID=local
BOT_ID=bot-lotes-cadastro-playwright-mk7

# Cadastro web local.
BOT_URL=http://frontend:3000
BOT_HEADLESS=true
BOT_USUARIO=automacao
BOT_SENHA=automacao
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_URL=http://frontend:3000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_ARTIFACTS_DIR=artefatos
