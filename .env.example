MAESTRO_ENABLED=false
APP_TIMEZONE=America/Manaus

# Credenciais opcionais para desenvolvimento local.
# O BotRunner fornece esses valores durante a execução.
MAESTRO_SERVER=
MAESTRO_LOGIN=
MAESTRO_KEY=
MAESTRO_TASK_ID=
MAESTRO_ACTIVITY_LABEL=inspecao-lotes

# Caminhos relativos são resolvidos a partir da raiz do projeto.
BOT_INPUT_FILE=data/samples/inspecao_lotes_dia.xlsx
BOT_OUTPUT_DIR=data/output
BOT_LOG_DIR=logs
BOT_EXECUTION_REPORT_FILE=logs/resumo_execucao.json

# DataPool local por padrão. No BotRunner, use botcity.
DATAPOOL_BACKEND=local
DATAPOOL_LABEL=lotes-inspecao-validacao-off-guilliman
DATAPOOL_LOCAL_DIR=data/datapool
VALIDATOR_ACTIVITY_LABEL=messyas-bot-conferencia-v1

# Identificação dos logs JSON.
EXECUTION_ID=local
BOT_ID=bot-lotes-cadastro-playwright-mk7

# Cadastro web local via página HTML estática (ou use file:///caminho/absoluto/web/lote-teste.html).
# Se deixado em branco, o sistema resolve automaticamente para web/lote-teste.html da raiz.
BOT_URL=
BOT_HEADLESS=true
BOT_USUARIO=automacao
BOT_SENHA=automacao
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_URL=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_ARTIFACTS_DIR=screenshots

# Configurações do Microserviço de ML (Estudo de Caso S10-B)
ML_ENABLED=true
ML_API_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1000
ML_FAILURE_THRESHOLD=5
ML_MODEL_PATH=models/classificador_lotes.pkl
ML_CONFIANCA_MINIMA=0.70

# Notificações Multicanal (Telegram principal + WhatsApp/Email secundário)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=AC123456789
TWILIO_AUTH_TOKEN=secret
WHATSAPP_TO=whatsapp:+5511999999999
WHATSAPP_FROM=whatsapp:+14155238886

EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=bot@empresa.com
EMAIL_TO=operacao@empresa.com

# Gmail API/OAuth: usado somente como fallback para alertas ERRO/CRÍTICO.
# Não versione os arquivos de credenciais e token. Autorize localmente com:
# python scripts/autorizar_gmail.py
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_FROM=
GMAIL_TO=

# Usados pelo perfil Docker `gmail` somente durante a autorização OAuth.
GMAIL_OAUTH_PORT=0
GMAIL_OAUTH_BIND_ADDRESS=
GMAIL_OAUTH_REDIRECT_HOST=localhost
GMAIL_OAUTH_OPEN_BROWSER=true

# Arquivo de itens irrecuperáveis (Dead Letter)
DEAD_LETTER_FILE=data/output/dead_letter.jsonl

