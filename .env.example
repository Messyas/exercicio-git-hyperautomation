MAESTRO_ENABLED=false
APP_TIMEZONE=America/Manaus

# Credenciais opcionais para desenvolvimento local.
# O BotRunner fornece esses valores durante a execução.
MAESTRO_SERVER=
MAESTRO_LOGIN=
MAESTRO_KEY=
MAESTRO_TASK_ID=
MAESTRO_ACTIVITY_LABEL=inspecao-lotes

# Caminhos relativos são resolvidos a partir da raiz do projeto.
BOT_INPUT_FILE=data/samples/inspecao_lotes_dia.xlsx
BOT_OUTPUT_DIR=data/output
BOT_LOG_DIR=logs
BOT_EXECUTION_REPORT_FILE=logs/resumo_execucao.json

# DataPool local por padrão. No BotRunner, use botcity.
DATAPOOL_BACKEND=local
DATAPOOL_LABEL=lotes-inspecao-validacao-off-guilliman
DATAPOOL_LOCAL_DIR=data/datapool
VALIDATOR_ACTIVITY_LABEL=bot-lotes-validacao-mk7

# Identificação dos logs JSON.
EXECUTION_ID=local
BOT_ID=bot-lotes-cadastro-playwright-mk7

# Cadastro web local via página HTML estática (ou use file:///caminho/absoluto/web/lote-teste.html).
# Se deixado em branco, o sistema resolve automaticamente para web/lote-teste.html da raiz.
BOT_URL=
BOT_HEADLESS=true
BOT_USUARIO=automacao
BOT_SENHA=automacao
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_URL=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_ARTIFACTS_DIR=screenshots

# Configurações do Microserviço de ML
ML_ENABLED=true
ML_API_URL=http://api-ml:8000
ML_TIMEOUT_MS=1000
ML_FAILURE_THRESHOLD=5
ML_MODEL_PATH=models/classificador_lotes.pkl
