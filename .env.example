MAESTRO_ENABLED=false

# Configure estas variaveis no ambiente do BotCity.
MAESTRO_SERVER=
MAESTRO_LOGIN=
MAESTRO_KEY=
MAESTRO_TASK_ID=
MAESTRO_ACTIVITY_LABEL=auditoria-acessos

# Caminhos relativos sao resolvidos a partir da raiz do projeto.
BOT_INPUT_DIR=dados_entrada
BOT_INPUT_FILE=data/samples/inspecao_lotes_dia.xlsx
BOT_OUTPUT_DIR=data/output
BOT_LOG_DIR=logs
BOT_EXECUTION_REPORT_FILE=logs/resumo_execucao.json

# IDs injetados automaticamente nos logs estruturados (JSON).
# Em producao, o BotCity Maestro preenche essas variaveis.
EXECUTION_ID=local
BOT_ID=bot-conferencia-lotes

# Automacao web opcional. A URL pode continuar apontando para o Vercel
# enquanto a pagina local ainda nao estiver disponivel.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_URL=https://lote-seven.vercel.app/
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=300
PLAYWRIGHT_QUANTITY=10
PLAYWRIGHT_ARTIFACTS_DIR=artefatos
