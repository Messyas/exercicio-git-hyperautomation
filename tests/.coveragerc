[run]
source =
    src
omit =
    src/pages/*
    src/playwright_automation.py

[report]
show_missing = True
skip_covered = False
fail_under = 80
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[html]
directory = data/reports/coverage-html

[xml]
output = data/reports/coverage.xml
