[run]
source =
    src
    dashboard
omit =
    src/pages/*
    src/playwright_automation.py
    dashboard/app.py

[report]
show_missing = True
skip_covered = False
fail_under = 80
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[html]
directory = reports/coverage-html

[xml]
output = reports/coverage.xml
